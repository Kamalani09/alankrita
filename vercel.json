{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/storefront.mjs": {
      "includeFiles": "client/dist/index.html"
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/",
      "dest": "/api/storefront?__storefront_path=/"
    },
    {
      "src": "/robots\\.txt",
      "dest": "/api/storefront?__storefront_path=/robots.txt"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "/api/storefront?__storefront_path=/sitemap.xml"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:api|assets)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/api/storefront?__storefront_path=/$1"
    }
  ]
}
